# Supabase project (public values; the database only lets the owner in)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Secret for the daily automatic search (any long random text; its hash is stored in jh_settings)
CRON_SECRET=
# Optional: turns on AI scoring and AI-written letters. Without it the app uses rules and templates.
ANTHROPIC_API_KEY=
# Optional: change the AI models
# AI_MODEL_SCORE=claude-haiku-5-5
# AI_MODEL_WRITE=claude-opus-5-5
